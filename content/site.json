 "media_desc": {
  "drone": "סרטון אווירה ללא קול, 10 שניות: צילום רחפן מלמעלה של הבריכה החיצונית של בארבור. שחייניות יוצרות צורת כוכב במים, והמצלמה נעה לאורך מסלולי השחייה, הסככות והדק שליד הבריכה.",
  "artswim": "סרטון אווירה ללא קול, 6 שניות: קבוצת שחייניות בכובעי ים צבעוניים מתאמנת בשחייה אמנותית בבריכה, ושוחה יחד בתנועה מתואמת."
 },
 "a11y": {
  "updated": "16.11.2026",
  "coordinator": {
   "name": "יבגני לודקין",
   "tel": "054-5405227",
   "tel_i": "+972545405227",
   "mail": "Lodkin.y.brb@gmail.com"
  },
  "audit_note": "האתר יעבור בדיקה של מורשה נגישות שירות, שתתואם דרך עיריית תל אביב-יפו. ההצהרה תעודכן אחרי הבדיקה.",
  "tested": "ב־16.11.2026 נבדקו כל 14 עמודי האתר: בדיקה אוטומטית, וגם בדיקה ידנית של ניווט במקלדת, של סימון המיקוד, של הניגודיות מעל הצילומים והסרטונים, של ריווח טקסט מוגדל ושל עצירת התנועה. באותו יום האתר עבר גם בדיקה חיצונית, והליקויים שנמצאו בה בניווט במקלדת תוקנו.",
  "browser": "Google Chrome 153",
  "tool": "axe-core 4.14",
  "limits": [
   "האתר עוד לא נבדק עם תוכנות קריאת מסך ועם הגדלת מסך של מערכת ההפעלה. הבדיקה מתוכננת במסגרת הבדיקה של מורשה הנגישות.",
   "בחלק מטופסי ההרשמה לחוגים, המחירון מופיע כתמונה בלי טקסט חלופי. אנחנו עובדים על גרסה כתובה. עד אז, את המחירים והפרטים אפשר לקבל במזכירות בטלפון או בוואטסאפ.",
   "המידע על נגישות המבנה והשירות בבארבור (חניה, כניסות, מעליות, שירותים, אמצעי עזר) נמצא בבדיקה ויפורסם כאן בקרוב. עד אז אפשר לברר אותו במזכירות."
  ]
 }
